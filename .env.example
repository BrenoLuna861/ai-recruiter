# ============================================================
# AI RECRUITER — Environment Variables
# Copie para .env e preencha TODOS os valores antes do deploy
# NUNCA commite o .env real no git
# ============================================================

# ===== ANTHROPIC AI (OBRIGATORIO) =====
# Gere em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-SUBSTITUA-PELA-SUA-CHAVE-REAL

# ===== MySQL =====
# Use senhas longas e aleatorias (minimo 20 caracteres)
# Gere com: openssl rand -base64 20
MYSQL_ROOT_PASSWORD=GERE_UMA_SENHA_FORTE_AQUI
MYSQL_USER=airecruiter
MYSQL_PASSWORD=GERE_OUTRA_SENHA_FORTE_AQUI

# ===== MongoDB =====
MONGO_USER=airecruiter_mongo
MONGO_PASSWORD=GERE_OUTRA_SENHA_FORTE_AQUI

# ===== JWT =====
# OBRIGATORIO: gere com o comando abaixo (minimo 64 bytes / 512 bits)
# openssl rand -base64 64
JWT_SECRET=COLE_AQUI_O_OUTPUT_DO_OPENSSL_RAND

# ===== CORS =====
# Liste APENAS os dominios do seu frontend, separados por virgula
# Sem wildcard (*) em producao
CORS_ORIGINS=https://ai-recruiter.com.br,https://www.ai-recruiter.com.br

# ===== FRONTEND =====
VITE_API_URL=/api
# Client ID OAuth criado em https://console.cloud.google.com/apis/credentials
# Use o mesmo valor em GOOGLE_OAUTH_CLIENT_ID (backend) e VITE_GOOGLE_CLIENT_ID (frontend)
VITE_GOOGLE_CLIENT_ID=

# ===== GOOGLE OAUTH (login com Google) =====
GOOGLE_OAUTH_CLIENT_ID=

# ===== E-MAIL / RECUPERACAO DE SENHA =====
# Chave da API do Resend (https://resend.com -> API Keys). Comeca com "re_".
# Se deixar em branco, o backend NAO envia e-mail: ele imprime o link de
# recuperacao no log, o que serve para testar o fluxo em desenvolvimento.
RESEND_API_KEY=

# Remetente. O padrao "onboarding@resend.dev" so entrega para o e-mail dono da
# conta Resend. Para enviar a qualquer usuario, verifique um dominio no painel
# do Resend (Domains -> Add Domain) e use um endereco dele.
RESEND_FROM=AI Recruiter <onboarding@resend.dev>

# URL do frontend — e com ela que o link do e-mail e montado.
# Se estiver errada, o e-mail chega mas o link nao leva a lugar nenhum.
APP_FRONTEND_URL=http://localhost:5173

# Validade do link, em minutos
PASSWORD_RESET_TTL_MINUTES=15

# ===== VAGAS EXTERNAS =====
# Crie uma conta em https://developer.adzuna.com para obter as duas chaves.
# O plano gratuito da 1.000 chamadas por MES — por isso o backend faz cache.
# Se ficarem em branco, o sistema usa o Remotive (vagas remotas, sem cadastro).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=br

# Minutos de cache das buscas externas
JOBS_CACHE_MINUTES=30

# ===== ADMIN BOOTSTRAP (opcional) =====
# Se preenchido, cria automaticamente um usuario ADMIN no primeiro start.
# Deixe em branco para nao criar nenhuma conta automaticamente.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Administrator

# ===== Spring Profile =====
# Use 'prod' em producao. Nunca 'dev'.
SPRING_PROFILES_AC