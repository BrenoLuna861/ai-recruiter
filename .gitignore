# Variáveis de ambiente — NUNCA commitar
.env
.env.local
.env.production

# Certificados SSL
deploy/ssl/

# ===== Artefatos de build =====
# Nada aqui precisa estar no git: o Dockerfile reconstroi o frontend e o backend
# do zero a cada deploy. Manter esses diretorios rastreados so gera diff gigante
# a cada build e o risco de commitar artefato desatualizado sem querer.
node_modules/
dist/
target/

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
